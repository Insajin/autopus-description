{
  "name": "@autopus/figma-read",
  "version": "0.1.0",
  "private": true,
  "description": "SPEC-FIGMA-002 Figma MCP read-only adapter pipeline + SPEC-FIGMA-003 description generation loop.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "bin": {
    "figma-read": "./dist/src/cli.js",
    "generate-descriptions": "./dist/src/cli/generate-descriptions.js",
    "autopus-daemon": "./dist/src/daemon/cli.js",
    "autopus-mcp-stdio": "./dist/src/daemon/mcp-stdio-entry.js"
  },
  "main": "./dist/src/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/prepend-shebang.mjs",
    "test": "vitest run --reporter=default",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.0",
    "@modelcontextprotocol/sdk": "^1.13.1",
    "openai": "^6.36.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "postcss": "^8.5.14",
    "next": {
      "postcss": "^8.5.14"
    }
  }
