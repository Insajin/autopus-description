{
  "name": "@autopus/figma-mcp",
  "version": "0.3.11",
  "description": "MCP server for the Autopus Figma description workflow — read frames, generate descriptions, manage briefs, write back via plugin bridge.",
  "type": "module",
  "license": "MIT",
  "author": "Bitgapnam",
  "homepage": "https://github.com/Insajin/autopus-description#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Insajin/autopus-description.git"
  },
  "bugs": {
    "url": "https://github.com/Insajin/autopus-description/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "figma",
    "autopus",
    "claude",
    "codex",
    "cursor",
    "anthropic",
    "ai",
    "description-generator",
    "design-handoff"
  ],
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/validate-manifest"
  ],
  "bin": {
    "figma-read": "./dist/src/cli.js",
    "generate-descriptions": "./dist/src/cli/generate-descriptions.js",
    "autopus-daemon": "./dist/src/daemon/cli.js",
    "autopus-mcp-stdio": "./dist/src/daemon/mcp-stdio-entry.js",
    "autopus-mcp-http": "./dist/src/daemon/mcp-http-entry.js"
  },
  "main": "./dist/src/cli.js",
  "files": [
    "dist/src/",
    "dist/types/",
    "dist/packages/",
    "dist/plugin/",
    "schema/",
    "types/",
    "scripts/prepend-shebang.mjs",
    "scripts/build-figma-plugin.mjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "npm run build --workspace @autopus/validate-manifest && tsc -p tsconfig.json && node scripts/prepend-shebang.mjs && node scripts/build-figma-plugin.mjs",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "test": "vitest run --reporter=default",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run lint && npm run build && npm test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.0",
    "@modelcontextprotocol/sdk": "^1.13.1",
    "openai": "^6.36.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "postcss": "^8.5.14",
    "next": {
      "postcss": "^8.5.14"
    }
  }
}
