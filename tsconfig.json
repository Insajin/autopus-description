{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "noEmitOnError": true,
    "baseUrl": ".",
    "paths": {
      "@autopus/write-router": ["packages/write-router/src/index.ts"],
      "@autopus/write-router/*": ["packages/write-router/src/*"],
      "@autopus/review-ui/*": ["apps/review-ui/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "types/**/*.d.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tools/**",
    "apps/**",
    "packages/**"
  ]
}
